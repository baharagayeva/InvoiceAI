@baseUrl = http://localhost:5297

### 1. Sadə sual
POST {{baseUrl}}/api/ai/ask
Content-Type: application/json

{
  "question": "What is factoring?"
}

### 2. Azərbaycanca eyni sual
POST {{baseUrl}}/api/ai/ask
Content-Type: application/json

{
  "question": "Faktorinq nədir?"
}

### 3. Hallüsinasiya testi
POST {{baseUrl}}/api/ai/ask
Content-Type: application/json

{
  "question": "What was Ferrum Capital's revenue in 2025?"
}

### 4. Temperature testi
POST {{baseUrl}}/api/ai/ask
Content-Type: application/json

{
  "question": "What is factoring?",
  "temperature": 1.0
}

### Faktura 1 (EN)
POST {{baseUrl}}/api/invoices/extract
Content-Type: multipart/form-data; boundary=B

--B
Content-Disposition: form-data; name="file"; filename="invoice_01_en.pdf"
Content-Type: application/pdf

< ./TestData/invoice_01_en.pdf
--B--

